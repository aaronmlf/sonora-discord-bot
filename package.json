{
  "name": "sonora-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot de musica self-hosted para Discord com painel web local.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "host:check": "node scripts/check-host.mjs",
    "host:pack": "npm run build && node scripts/pack-host.mjs",
    "public:pack": "node scripts/pack-public.mjs",
    "remote:start": "node scripts/remote-access.mjs start",
    "remote:status": "node scripts/remote-access.mjs status",
    "remote:stop": "node scripts/remote-access.mjs stop"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "opusscript": "^0.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
