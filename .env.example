# Credenciais da aplicacao criada no Discord Developer Portal.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Opcional: registra os comandos imediatamente apenas neste servidor durante o desenvolvimento.
DISCORD_GUILD_ID=

# O painel fica acessivel somente nesta maquina por padrao.
HOST=127.0.0.1
PORT=3210

# Obrigatorio se HOST for alterado para um endereco acessivel pela rede.
ADMIN_TOKEN=

# Compartilhamento opcional por convite. Mantenha HOST=127.0.0.1 com Tailscale Funnel.
REMOTE_ACCESS_ENABLED=false
# URL HTTPS exibida por `npm run remote:status` (sem barra no final).
PUBLIC_URL=

AUDIO_DIR=./data/audio
DATA_DIR=./data

# Executavel usado pelo modo experimental de YouTube/Spotify.
YTDLP_PATH=yt-dlp
# Opcional: necessario apenas quando o YouTube exigir autenticacao.
YTDLP_COOKIES_FILE=

DEFAULT_VOLUME=70
DEFAULT_EFFECT_VOLUME=100
IDLE_TIMEOUT_SECONDS=300
MAX_UPLOAD_MB=100
LOG_LEVEL=info
